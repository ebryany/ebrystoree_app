# Copy to .env and fill in real values. Never commit .env.
# Public Supabase values (safe for browser bundles)
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase values (never expose to client)
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged key. Full RLS bypass — treat as a production secret.
SUPABASE_SERVICE_ROLE_KEY=
