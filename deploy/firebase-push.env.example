# Simpan salinan file ini di VPS sebagai /etc/ebrystore/firebase-push.env
# lalu kunci izin akses:
#   sudo chown root:ebrystore /etc/ebrystore/firebase-push.env /etc/ebrystore/firebase-service-account.json
#   sudo chmod 640 /etc/ebrystore/firebase-push.env /etc/ebrystore/firebase-service-account.json
#
# Jangan pernah commit file kredensial asli ke GitHub!

# Opsi utama (paling aman di VPS): path ke file Service Account JSON dari Firebase Console
FCM_SERVICE_ACCOUNT_PATH=/etc/ebrystore/firebase-service-account.json

# Interval sweep pengaman (milidetik, default 60000 = 60 detik)
PUSH_SWEEP_INTERVAL_MS=60000
